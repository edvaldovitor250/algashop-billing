package com.algaworks.algashop.billing.infrastructure.creditcard.fake.fastpay;

import java.util.UUID;

import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.stereotype.Service;

import com.algaworks.algashop.billing.domain.model.creditcard.CreditCardProviderService;
import com.algaworks.algashop.billing.domain.model.creditcard.LimitedCreditCard;
import com.algaworks.algashop.billing.domain.model.creditcard.Options;
import com.algaworks.algashop.billing.infrastructure.payment.AlgaShopPaymentPropreties;


@Service
@ConditionalOnProperty(name = "algashop.integrations.payment.provider", havingValue = "FASTPAY")
public class CreditCardProviderServiceFastImpl implements CreditCardProviderService {

    private final AlgaShopPaymentPropreties.FastpayProperties fastpayProperties;

    public CreditCardProviderServiceFastImpl(AlgaShopPaymentPropreties.FastpayProperties fastpayProperties) {
        this.fastpayProperties = fastpayProperties;
    }

    @Override
    public LimitedCreditCard register(UUID customerId, String tokenizedCard) {
        // Simulate interaction with Fastpay API using fastpayProperties
        // For demonstration, returning a dummy LimitedCreditCard
        return LimitedCreditCard.builder()
                .gatewayCode("fastpay-" + customerId)
                .lastNumbers(tokenizedCard.substring(tokenizedCard.length() - 4))
                .brand("VISA")
                .expMonth(12)
                .expYear(2026)
                .build();
    }

    @Override
    public Options<LimitedCreditCard> findById(String providerCreditCardCode) {
        // Simulate fetching card details from Fastpay API
        // For demonstration, returning an empty Options
        return Options.empty();
    }

    @Override
    public void delete(String gatewayCode) {
        // Simulate deletion of card from Fastpay API
        // No return value needed
    }
}